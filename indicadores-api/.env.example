# Cadena de conexion de MongoDB Atlas. Usa un usuario de SOLO LECTURA.
# Si la dejas vacia, el servicio arranca en modo demostracion (datos inventados).
MONGODB_URI=
# Nombre de la base (si no va dentro de la URI). Por defecto: skillmatch
DB_NAME=
# 1 = datos de demostracion aunque haya MONGODB_URI
MODO_DEMO=
# Segundos que se guardan los datos leidos antes de volver a consultar Mongo
CACHE_SEGUNDOS=300
# Paginas que pueden llamar a esta API, separadas por coma (localhost ya esta permitido)
ALLOWED_ORIGINS=https://skillmatch-yz37.onrender.com
