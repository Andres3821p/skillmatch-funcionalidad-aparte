# ---- De donde salen los datos ----
# Sin nada configurado, el servicio lee la API PUBLICA del sitio en vivo de SkillMatch.
# FUENTE=api | mongo | demo   (si no se pone, se elige solo: mongo si hay MONGODB_URI, si no api)
FUENTE=

# Direccion de la API publica de SkillMatch (fuente "api")
SKILLMATCH_API=https://skillmatch-yz37.onrender.com/api

# Cadena de conexion de MongoDB Atlas (fuente "mongo"). Usa un usuario de SOLO LECTURA.
# Con ella se activan los indicadores de personas y postulaciones.
MONGODB_URI=
# Nombre de la base (si no va dentro de la URI). Por defecto: skillmatch
DB_NAME=

# 1 = datos de demostracion inventados (para probar sin internet)
MODO_DEMO=

# Segundos que se guardan los datos antes de volver a leerlos (por defecto 900 con la API, 300 con Mongo)
CACHE_SEGUNDOS=

# Solo si otra pagina (en otro dominio) va a llamar a esta API. La pagina propia no lo necesita.
ALLOWED_ORIGINS=https://skillmatch-yz37.onrender.com
